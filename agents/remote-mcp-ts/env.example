# LLM provider
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
OPENAI_BASE_URL=

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
ANTHROPIC_BASE_URL=

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# GitHub remote MCP bearer token
GITHUB_MCP_TOKEN=

# Atlas cloud-dev Remote MCP bootstrap inputs.
# Create a Global Service Account in cloud-dev with enough permissions to create
# the group-level MCP config, then set these before running:
#   scripts/create-atlas-mcp-config.sh create --env-file .env.atlas
ATLAS_GROUP_ID=
ATLAS_DEV_GSA_CLIENT_ID=
ATLAS_DEV_GSA_CLIENT_SECRET=

# Atlas cloud-dev Remote MCP client-credentials output is written to .env.atlas
# by scripts/create-atlas-mcp-config.sh. Do not seed the generated output keys in
# .env; blank assignments there can shadow the generated credentials.
