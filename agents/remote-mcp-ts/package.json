{
  "name": "remote-mcp-ts",
  "version": "0.1.0",
  "description": "Remote MCP example agents (TypeScript)",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@11.2.2",
  "scripts": {
    "build": "tsc",
    "start": "node --enable-source-maps dist/remote_mcp_ts/main.js",
    "start:github": "node --enable-source-maps dist/remote_mcp_ts/github.js",
    "start:sentry": "node --enable-source-maps dist/remote_mcp_ts/sentry.js",
    "start:glean": "node --enable-source-maps dist/remote_mcp_ts/glean.js",
    "start:atlas": "node --enable-source-maps dist/remote_mcp_ts/atlas.js",
    "dev": "tsx watch src/remote_mcp_ts/main.ts"
  },
  "dependencies": {
    "@magenta/sdk-core-ts": "git+https://github.com/10gen/magenta-client-libraries#path:packages/sdk-core-ts",
    "@magenta/runner-shared-ts": "git+https://github.com/10gen/magenta-client-libraries#path:packages/runner-shared-ts",
    "@magenta/magenta-sdklanggraph-ts": "git+https://github.com/10gen/magenta-client-libraries#path:packages/magenta-sdklanggraph-ts",
    "@langchain/anthropic": "^1.4.0",
    "@langchain/core": "^1.1.48",
    "@langchain/google-genai": "^2.1.0",
    "@langchain/langgraph": "^1.3.0",
    "@langchain/openai": "^1.4.7",
    "@types/node": "^25.0.0",
    "dotenv": "^16.4.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "tsx": "^4.16.0",
    "typescript": "^5.5.0"
  },
  "engines": {
    "node": ">=20"
  }
}
