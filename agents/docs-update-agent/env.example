# MongoDB Connection
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=docs_update_agent

# LLM - set ONE provider key. Grove Foundry uses OPENAI_API_KEY or
# ANTHROPIC_API_KEY with the matching provider-specific base URL.
OPENAI_API_KEY=
OPENAI_BASE_URL=
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=
GEMINI_API_KEY=
CEREBRAS_API_KEY=

# GitHub - classic PAT with `repo` scope, SSO-authorized for 10gen
GITHUB_TOKEN=

# Target repository to monitor for doc updates
TARGET_REPO=10gen/agentic-platform

# How many days back to look for changes (default: 1 for daily runs)
LOOKBACK_DAYS=1

# Features
ENABLE_TRACING=false
