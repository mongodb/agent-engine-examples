# Runtime checkpoint store (in agentic dev this is overridden to the
# stack-internal "mongodb" service).
MONGODB_URI=mongodb://127.0.0.1:27015/?directConnection=true
MONGODB_DATABASE=agent_memory

# Where the booking / hotel / policy data lives. Use host.docker.internal
# when running inside `agentic dev` so the container can reach a host-side
# Atlas Local cluster.
HOLIDAY_MONGODB_URI=mongodb://host.docker.internal:27015/?directConnection=true
HOLIDAY_DATABASE=holiday_db

# LLM — set ONE provider key.
OPENAI_API_KEY=
OPENAI_BASE_URL=
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=
GEMINI_API_KEY=
CEREBRAS_API_KEY=

# Voyage embeddings for hotel / policy semantic search.
VOYAGE_API_KEY=
VOYAGE_DIMENSION=1024

# Features
ENABLE_TRACING=false
ENABLE_MEMORY=true
