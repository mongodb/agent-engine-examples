# Runtime checkpoint store (in agentic dev this is overridden to the
# stack-internal "mongodb" service).
MONGODB_URI=mongodb://127.0.0.1:27015/?directConnection=true
MONGODB_DATABASE=agent_memory

# Where the store operational / inventory data lives. Use host.docker.internal
# when running inside `agentic dev` so the container can reach a host-side
# Atlas Local cluster.
STORE_MONGODB_URI=mongodb://host.docker.internal:27015/?directConnection=true
STORE_DATABASE=store_db

# LLM — set ONE provider key.
OPENAI_API_KEY=
OPENAI_BASE_URL=
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=
GEMINI_API_KEY=
# Default is gemini-2.5-pro (strong multi-step / multi-item tool use). Override
# here if needed; note pro/thinking-only models must run in thinking mode.
GEMINI_MODEL=gemini-2.5-pro
CEREBRAS_API_KEY=

# Voyage embeddings for semantic / episodic memory.
VOYAGE_API_KEY=
VOYAGE_DIMENSION=1024

# Features
ENABLE_TRACING=false
ENABLE_MEMORY=true
