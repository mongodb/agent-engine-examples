# Copy this file to .env before running the app.
# `agent.yaml` owns app metadata, feature flags, and model selection.
# `.env` should only contain local secrets and environment-specific endpoints.

# MongoDB connection string for seeding or non-dev runs.
# Leave empty for local `agentic dev`; the CLI provides the local MongoDB URI.
MONGODB_URI=

# Set true only when you want to pre-seed the replay playbook instead of
# learning it from Session 1.
SEED_PROCEDURAL_MEMORY_ON_STARTUP=false

# Approval threshold for partner or exception recovery spend (USD).
PARTNER_COST_THRESHOLD=650

# Voyage API key for memory embeddings.
# Required because `features.memory: true` in agent.yaml.
VOYAGE_API_KEY=

# LLM credentials. Configure config.provider and config.model in agent.yaml,
# then set the matching key below.

# Cerebras
CEREBRAS_API_KEY=

# Google Gemini
GEMINI_API_KEY=

# OpenAI or OpenAI-compatible Grove Foundry
OPENAI_API_KEY=
OPENAI_BASE_URL=
