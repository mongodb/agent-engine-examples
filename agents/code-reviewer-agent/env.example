# LLM Provider
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4
OPENAI_REASONING_EFFORT=medium
# Optional. Overrides the default OpenAI base URL. Set to your Grove
# endpoint (URL contains ``grove-foundry``) to use MongoDB's Azure APIM
# proxy — the agent auto-detects Grove and switches to the ``api-key``
# header instead of ``Authorization: Bearer``. Leave blank for vanilla
# OpenAI.
OPENAI_BASE_URL=

# MongoDB Connection (for checkpointing)
MONGODB_URI=

# GitHub — classic PAT with `repo` scope, required to review 10gen PRs.
# For 10gen/agentic-platform (SSO-enforced org): after creating the token,
# visit github.com → Settings → Developer settings → Personal access
# tokens → <your token> → Configure SSO → Authorize for `10gen`.
# Without the SSO authorization, API calls return 404 for private repos
# even though the token itself is valid.
GITHUB_TOKEN=

# Optional repo allowlist. Comma-separated ``owner/repo`` entries; when
# set, ``fetch_pr_diff`` and ``fetch_pr_files`` reject URLs that don't
# match. Leave blank to allow any repo the GITHUB_TOKEN can read.
# Example: ``GITHUB_ALLOWED_REPOS=10gen/agentic-platform,10gen/magenta-examples``
GITHUB_ALLOWED_REPOS=

# Application Settings
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO
