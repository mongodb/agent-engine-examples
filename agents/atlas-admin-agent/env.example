# MongoDB Atlas Admin API
# Get your API keys from: https://cloud.mongodb.com/v2#/account/publicApi
ATLAS_PUBLIC_KEY=
ATLAS_PRIVATE_KEY=
ATLAS_ORG_ID=
ATLAS_API_BASE_URL=https://cloud.mongodb.com/api/atlas/v2

# MongoDB connection used for agent checkpointing + workflow run state.
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=atlas_admin_agent

# LLM — set ONE provider key. Grove Foundry uses OPENAI_API_KEY or
# ANTHROPIC_API_KEY with the matching provider-specific base URL.
OPENAI_API_KEY=
OPENAI_BASE_URL=
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=
GEMINI_API_KEY=
CEREBRAS_API_KEY=

# Features
ENABLE_TRACING=false
ENABLE_MEMORY=false
