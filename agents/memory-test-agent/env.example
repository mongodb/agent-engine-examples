# MongoDB Connection (injected by platform in production)
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=memory_test_agent

# OE URL (injected by platform in production)
OE_URL=http://localhost:8000

# Required for memory embeddings (features.memory: true in agent.yaml)
VOYAGE_API_KEY=

# LLM — set ONE provider key
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
CEREBRAS_API_KEY=
