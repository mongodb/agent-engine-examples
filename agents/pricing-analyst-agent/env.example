# MongoDB Connection
MONGODB_URI="atlas dedicated cluster connection string"
MONGODB_DATABASE=tenant
ENABLE_MEMORY=true
ENABLE_TRACING=true
ENABLE_GUARDRAILS=true
GUARDRAILS_SERVER_URL=


# Embedder credentials (required for memory)
VOYAGE_API_KEY=
VOYAGE_DIMENSION=1024

# LLM Provider - Set at least one. Grove Foundry uses OPENAI_API_KEY or
# ANTHROPIC_API_KEY with the matching provider-specific base URL.
# Cerebras
CEREBRAS_API_KEY=
CEREBRAS_MODEL=qwen-3-235b-a22b-instruct-2507
# Gemini (fallback if Cerebras is not set)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3-flash-preview
# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
# Optional: Override OpenAI API base URL to use an OpenAI-compatible endpoint
# (e.g., Grove Foundry model inference)
OPENAI_BASE_URL=
# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
# Optional: Override Anthropic API base URL to use an Anthropic-compatible endpoint
ANTHROPIC_BASE_URL=
