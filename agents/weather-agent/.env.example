MONGODB_URI=mongodb+srv://<user>:<pass>@<cluster>.mongodb.net
# Provide at least one LLM key; OPENAI takes priority, then GEMINI, then CEREBRAS.
# Grove Foundry OpenAI-compatible URLs use OPENAI_API_KEY plus OPENAI_BASE_URL.
OPENAI_API_KEY=sk-...
OPENAI_BASE_URL=
GEMINI_API_KEY=AIza...
CEREBRAS_API_KEY=csk-...
