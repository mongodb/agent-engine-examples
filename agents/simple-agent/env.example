# MongoDB Connection
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=simple_agent

# LLM - set ONE provider key. Grove Foundry uses OPENAI_API_KEY or
# ANTHROPIC_API_KEY with the matching provider-specific base URL.
OPENAI_API_KEY=
OPENAI_BASE_URL=
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=
GEMINI_API_KEY=
CEREBRAS_API_KEY=

# Features
ENABLE_TRACING=false
ENABLE_MEMORY=false

# crawl4ai — redirect base dir away from /root (read-only on platform)
# crawl4ai will create its .crawl4ai folder under this path
CRAWL4_AI_BASE_DIRECTORY=/tmp
