# MongoDB Connection
MONGODB_URI="atlas dedicated cluster connection string"
MONGODB_DATABASE=tenant

# Application database
TENANT_DATABASE=tenant

# LangGraph checkpoints
CHECKPOINT_DB_NAME=agent-checkpoints

# Seed initial users
SEED_DATA=true

# MongoDB Atlas Search
MONGODB_ENABLE_SEARCH_INDEXES=true

# Memory
ENABLE_MEMORY=true
MEMORY_DATABASE=memory

# Tracing
ENABLE_TRACING=true

# Guardrails
ENABLE_GUARDRAILS=true
GUARDRAILS_SERVER_URL=

# Embedder credentials (required for memory)
VOYAGE_API_KEY=
VOYAGE_DIMENSION=1024

# LLM Provider - Set at least one
# Cerebras
CEREBRAS_API_KEY=
CEREBRAS_MODEL=qwen-3-235b-a22b-instruct-2507

# Gemini (fallback if Cerebras is not set)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3-flash-preview

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Optional: Override OpenAI API base URL to use an OpenAI-compatible endpoint
OPENAI_BASE_URL=

# Local resume hosting
RESUME_SERVER_URL=http://localhost:8090

# Application settings
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# Runtime identifiers
ORG_ID=
PROJECT_ID=
WORKSPACE_ID=recruiting-assistant-agent
