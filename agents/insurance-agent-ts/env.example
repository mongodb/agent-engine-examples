# Copy this file to .env before running `agentic dev up` or `npm run dev`.
# `agent.yaml` owns app metadata, feature flags, and optional model hints.
# `.env` should only contain local secrets and environment-specific endpoints.

# MongoDB connection string for the app's policy/claim data.
# Leave empty for local `agentic dev`; the CLI provides the local MongoDB URI.
MONGODB_URI=

# MongoDB database used by this app's policy and claim collections.
MONGODB_DATABASE=insurance_agent_ts

# MongoDB database used by the Agentic runtime for checkpoints, memory, and traces.
# Keep this distinct from MONGODB_DATABASE so app data and runtime data stay separate.
MDB_AGENTIC_STORE_DB=mdb_agentic_store_insurance_agent_ts

# Voyage API key for memory embeddings. Required when features.memory: true.
VOYAGE_API_KEY=

# LLM credentials. Set the key matching config.provider in agent.yaml (or the
# only key present). Grove Foundry uses the provider key with the matching
# provider-specific base URL.

# Anthropic API key (config.provider: anthropic).
ANTHROPIC_API_KEY=
# Optional Anthropic-compatible base URL (e.g. Grove Foundry).
ANTHROPIC_BASE_URL=

# Google Gemini API key (config.provider: gemini).
GEMINI_API_KEY=

# OpenAI or OpenAI-compatible API key (config.provider: openai).
OPENAI_API_KEY=
# Optional OpenAI-compatible base URL (e.g. Grove Foundry, Azure OpenAI).
OPENAI_BASE_URL=

# Cerebras API key (config.provider: cerebras).
CEREBRAS_API_KEY=
