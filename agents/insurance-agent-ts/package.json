{
  "name": "insurance-agent-ts",
  "version": "0.1.0",
  "description": "Insurance agent demo built on @magenta/magenta-sdklanggraph-ts, showcasing deep-agent orchestration and long-term memory (TypeScript)",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@11.2.2",
  "main": "dist/insurance_agent_ts/main.js",
  "bin": {
    "insurance-agent-ts": "dist/insurance_agent_ts/main.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node --enable-source-maps dist/insurance_agent_ts/main.js",
    "dev": "tsx watch src/insurance_agent_ts/main.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@magenta/sdk-core-ts": "git+https://github.com/10gen/magenta-client-libraries#3175b5d2132fb6e44c4eb643435d048e0109ee8c&path:packages/sdk-core-ts",
    "@magenta/runner-shared-ts": "git+https://github.com/10gen/magenta-client-libraries#3175b5d2132fb6e44c4eb643435d048e0109ee8c&path:packages/runner-shared-ts",
    "@magenta/magenta-sdklanggraph-ts": "git+https://github.com/10gen/magenta-client-libraries#3175b5d2132fb6e44c4eb643435d048e0109ee8c&path:packages/magenta-sdklanggraph-ts",
    "@langchain/anthropic": "^1.4.0",
    "@langchain/cerebras": "^1.0.4",
    "@langchain/core": "^1.1.48",
    "@langchain/google-genai": "^2.1.0",
    "@langchain/langgraph": "^1.3.0",
    "@langchain/openai": "^1.4.7",
    "dotenv": "^16.4.5",
    "mongodb": "^6.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^25.0.0",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0",
    "vitest": "^4.1.6"
  },
  "engines": {
    "node": ">=20"
  }
}
