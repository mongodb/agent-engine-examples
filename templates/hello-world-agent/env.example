# Copy this file to .env before running `agentic dev up`.
#
# Set LLM_API_KEY for the client configured in the agent source.
# Change the model in the LLM builder.

MONGODB_URI=

# Credential for the LLM client in the agent source.
LLM_API_KEY=

# Required when features.memory is true in agent.yaml.
VOYAGE_API_KEY=
