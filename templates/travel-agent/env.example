# Copy this file to .env before running the app.

# Leave empty for local `agentengine dev`, which provides a local MongoDB.
# Set it to your Atlas connection string when running against your own cluster.
MONGODB_URI=

# Database for the flights, listings, and bookings collections.
MONGODB_DATABASE=travel_agent

# Database for Agent Engine's checkpoints, memory, and traces. Keep it separate
# from MONGODB_DATABASE.
MDB_AGENTIC_STORE_DB=mdb_agentic_store_travel_agent

# API key for the LLM client in src/travel_agent/llm.py.
LLM_API_KEY=

# Voyage AI API key for memory embeddings.
VOYAGE_API_KEY=
