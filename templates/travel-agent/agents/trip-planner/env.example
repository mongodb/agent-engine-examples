# Copy this file to .env before running the app.

# Your Atlas connection string. Local development also uses Atlas.
MONGODB_URI=

# Database for the flights, listings, and bookings collections.
MONGODB_DATABASE=travel_agent

# Database for Agent Engine's checkpoints, memory, and traces. Keep it separate
# from MONGODB_DATABASE.
MDB_AGENTIC_STORE_DB=mdb_agentic_store_travel_agent

# The Atlas project and cluster that the MongoDB MCP tools connect to.
ATLAS_PROJECT_ID=
ATLAS_CLUSTER_NAME=

# Client ID and secret of an Atlas Managed MCP configuration with the
# Project Data Access Read Only role.
MDB_MCP_CLIENT_ID=
MDB_MCP_CLIENT_SECRET=

# API key for the LLM client in src/trip_planner/llm.py.
LLM_API_KEY=

# Voyage AI API key for memory embeddings.
VOYAGE_API_KEY=
