# Copy this file to .env before running the app.
# `agent.yaml` owns app metadata, feature flags, and optional model hints.
# `.env` should only contain local secrets and environment-specific endpoints.

# MongoDB connection string for the app and Agentic runtime.
# Leave empty for local `agentic dev`; the CLI provides the local MongoDB URI.
# Set this only when running against your own MongoDB deployment.
MONGODB_URI=

# MongoDB database used by this app's policy and claim collections.
MONGODB_DATABASE=insurance_agent

# MongoDB database used by the Agentic runtime for checkpoints, memory, and traces.
# Keep this distinct from MONGODB_DATABASE so app data and runtime data stay separate.
MDB_AGENTIC_STORE_DB=mdb_agentic_store_insurance_agent

# Guardrails service endpoint.
# Required only when `features.guardrails: true` in agent.yaml.
# Leave empty when guardrails are disabled.
GUARDRAILS_SERVER_URL=

# LLM credentials. This sample app can optionally read config.provider and
# config.model from agent.yaml, but provider/model selection stays in
# application code rather than the runtime SDK.
# Set exactly one provider key for the simplest local setup. If multiple keys
# are present, set `config.provider` in agent.yaml to choose one explicitly.
# Grove Foundry uses OPENAI_API_KEY or ANTHROPIC_API_KEY with the matching
# provider-specific base URL.

# Anthropic API key. Use this when `config.provider: anthropic`, or when this is
# the only provider key set.
ANTHROPIC_API_KEY=

# Optional Anthropic-compatible API base URL, such as Grove Foundry. Grove Foundry
# URLs are normalized automatically and use the api-key header.
# Leave empty for Anthropic's default public API endpoint.
ANTHROPIC_BASE_URL=

# Google Gemini API key. Use this when `config.provider: gemini`, or when this
# is the only provider key set.
GEMINI_API_KEY=

# OpenAI or OpenAI-compatible API key. Use this when `config.provider: openai`,
# or when this is the only provider key set.
OPENAI_API_KEY=

# Optional OpenAI-compatible API base URL, such as Grove Foundry. Grove Foundry
# URLs are normalized automatically and use the api-key header.
# Leave empty for OpenAI's default public API endpoint.
OPENAI_BASE_URL=

# Voyage API key for memory embeddings.
# Required only when `features.memory: true` in agent.yaml.
VOYAGE_API_KEY=
