# Copy this file to .env before running the app.
# `agent.yaml` owns app metadata and feature flags; `src/insurance_agent/llm.py`
# owns the provider and model.
# `.env` should only contain local secrets.

# MongoDB connection string for the app and Agentic runtime.
# Leave empty for local `agentic dev`; the CLI provides the local MongoDB URI.
# Set this only when running against your own MongoDB deployment.
MONGODB_URI=

# MongoDB database used by this app's policy and claim collections.
MONGODB_DATABASE=insurance_agent

# MongoDB database used by the Agentic runtime for checkpoints, memory, and traces.
# Keep this distinct from MONGODB_DATABASE so app data and runtime data stay separate.
MDB_AGENTIC_STORE_DB=mdb_agentic_store_insurance_agent

# LLM credentials. Set the key read by the builder in src/insurance_agent/llm.py.
# When switching providers, update the client and model in source.

# Credential for the LLM client in the agent source.
LLM_API_KEY=

# Voyage API key for memory embeddings.
# Required only when `features.memory: true` in agent.yaml.
VOYAGE_API_KEY=
