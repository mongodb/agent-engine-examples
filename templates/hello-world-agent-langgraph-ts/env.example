# Copy this file to .env before running `agentic dev up` or `npm run dev`.
#
# Set exactly one provider key for normal local development. Grove Foundry uses
# OPENAI_API_KEY or ANTHROPIC_API_KEY with the matching provider-specific base URL.
# Optional model overrides can live in agent.yaml under config.model.

# MongoDB connection string used by the Magenta SDK for checkpointing,
# memory, traces, and the agentic store.
# Leave empty for `agentic dev up` (the local stack provides one automatically).
MONGODB_URI=

# Database name the Magenta runtime uses for checkpoints/traces.
MDB_AGENTIC_STORE_DB=mdb_agentic_store

# Memory server endpoint. Required only when `features.memory: true` in agent.yaml.
# `agentic dev up` injects this automatically; set it manually if running outside dev.
MEMORY_SERVER_URL=

# Guardrails service endpoint. Required only when `features.guardrails: true`.
GUARDRAILS_SERVER_URL=

# Gemini
GEMINI_API_KEY=

# OpenAI, OpenAI-compatible Grove Foundry, or Azure OpenAI
OPENAI_API_KEY=
OPENAI_BASE_URL=
AZURE_OPENAI_API_VERSION=

# Anthropic or Anthropic-compatible Grove Foundry
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=

# Cerebras
CEREBRAS_API_KEY=

# Required when features.memory is true in agent.yaml.
VOYAGE_API_KEY=

# Optional: HTTP port for the local server (defaults to 8000).
PORT=8000
