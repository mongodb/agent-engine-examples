# Copy this file to .env before running `agentengine dev up` or `npm run dev`.
#
# Set LLM_API_KEY for the client configured in the agent source.
# Change the model in the LLM builder.

# MongoDB connection string used by the SDK for checkpointing,
# memory, traces, and the agentengine store.
# Leave empty for `agentengine dev up` (the local stack provides one automatically).
MONGODB_URI=

# Database name the runtime uses for checkpoints/traces.
MDB_AGENTIC_STORE_DB=mdb_agentic_store

# Memory server endpoint. Required only when `features.memory: true` in agent.yaml.
# `agentengine dev up` injects this automatically; set it manually if running outside dev.
MEMORY_SERVER_URL=

# Credential for the LLM client in the agent source.
LLM_API_KEY=

# Required when features.memory is true in agent.yaml.
VOYAGE_API_KEY=

# Optional: HTTP port for the local server (defaults to 8000).
PORT=8000
