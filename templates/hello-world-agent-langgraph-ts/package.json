{
  "name": "hello-world-agent",
  "version": "0.1.0",
  "description": "Minimal agent hello-world starter template (TypeScript)",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@11.2.2",
  "main": "dist/hello_world_agent/main.js",
  "bin": {
    "hello-world-agent": "dist/hello_world_agent/main.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node --enable-source-maps dist/hello_world_agent/main.js",
    "dev": "tsx watch src/hello_world_agent/main.ts"
  },
  "dependencies": {
    "@mongodb-js/agent-engine-sdk": ">=0.11.3 <1",
    "@mongodb-js/agent-engine-runner-shared": ">=0.11.3 <1",
    "@mongodb-js/agent-engine-sdk-langgraph": ">=0.11.3 <1",
    "@langchain/anthropic": "^1.4.0",
    "@langchain/core": "^1.1.48",
    "@langchain/google-genai": "^2.1.0",
    "@langchain/langgraph": "^1.3.0",
    "@langchain/openai": "^1.4.7",
    "@langchain/xai": "^1.4.10",
    "dotenv": "^16.4.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^25.0.0",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0"
  },
  "engines": {
    "node": ">=20"
  }
}
